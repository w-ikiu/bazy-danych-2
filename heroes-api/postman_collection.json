  "item": [
    {
      "name": "1. Rejestracja bohatera (sukces)",
      "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });", "pm.test(\"Zwraca nowo utworzonego bohatera z ID\", function () { var jsonData = pm.response.json(); pm.expect(jsonData.data).to.have.property(\"id\"); });" ], "type": "text/javascript" } } ],
      "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Hulk\",\n  \"power\": \"strength\"\n}" }, "url": { "raw": "http://localhost:3000/api/v1/heroes", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "v1", "heroes"] } }
    },
    {
      "name": "2. Rejestracja bohatera (sukces)",
      "event": [ { "listen": "test", "script": { "exec": [ "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });" ], "type": "text/javascript" } } ],
      "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Flash\",\n  \"power\": \"speed\"\n}" }, "url": { "raw": "http://localhost:3000/api/v1/heroes", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "v1", "heroes"] } }
