      "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"location\": \"Bank Centralny\",\n  \"severity_level\": \"critical\"\n}" }, "url": { "raw": "http://localhost:3000/api/v1/incidents", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "v1", "incidents"] } }
