      "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tylko Imie\"\n}" }, "url": { "raw": "http://localhost:3000/api/v1/heroes", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "v1", "heroes"] } }
