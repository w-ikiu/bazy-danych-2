      "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"hero_id\": 1\n}" }, "url": { "raw": "http://localhost:3000/api/v1/incidents/999/assign", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "v1", "incidents", "999", "assign"] } }
