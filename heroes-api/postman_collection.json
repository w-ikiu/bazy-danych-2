      "request": { "method": "PATCH", "header": [], "url": { "raw": "http://localhost:3000/api/v1/incidents/1/resolve", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "v1", "incidents", "1", "resolve"] } }
